{
  "name": "@saebyn/glowing-telegram-video-editor",
  "description": "A video editor component for glowing-telegram",
  "version": "0.5.0",
  "license": "AGPL-3.0-only",
  "author": "saebynx@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saebyn/glowing-telegram-video-editor.git"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "module": "dist/glowing-telegram-video-editor.js",
  "exports": {
    ".": {
      "import": "./dist/glowing-telegram-video-editor.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": {
      "import": "./dist/glowing-telegram-video-editor.css"
    },
    "./custom-only.css": "./dist/custom-only.css"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/saebyn"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "vite build --watch",
    "build": "tsc && vite build && npx postcss src/custom-only.css -o dist/custom-only.css",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint -c .oxlintrc.json src/",
    "lint:fix": "oxlint -c .oxlintrc.json --fix src/",
    "lint:ci": "oxlint -c .oxlintrc.json --format github src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@keplar-404/react-timeline-editor": "1.0.11",
    "@tailwindcss/postcss": "^4.3.5",
    "hls.js": "^1.7.4",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "temporal-polyfill": "^1.0.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.3.1",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-links": "^10.6.8",
    "@storybook/addon-onboarding": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "material-symbols": "^0.49.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "postcss-cli": "^12.0.0",
    "storybook": "^10.6.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@storybook/react-vite": {
      "@joshwooding/vite-plugin-react-docgen-typescript": "0.9.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
