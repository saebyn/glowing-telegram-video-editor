{
  "name": "@saebyn/glowing-telegram-video-editor",
  "description": "A video editor component for glowing-telegram",
  "version": "0.5.0",
  "license": "AGPL-3.0-only",
  "author": "saebynx@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saebyn/glowing-telegram-video-editor.git"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "module": "dist/glowing-telegram-video-editor.js",
  "exports": {
    ".": {
      "import": "./dist/glowing-telegram-video-editor.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": {
      "import": "./dist/glowing-telegram-video-editor.css"
    },
    "./custom-only.css": "./dist/custom-only.css"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/saebyn"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "vite build --watch",
    "build": "tsc && vite build && npx postcss src/custom-only.css -o dist/custom-only.css",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint -c .oxlintrc.json src/",
    "lint:fix": "oxlint -c .oxlintrc.json --fix src/",
    "lint:ci": "oxlint -c .oxlintrc.json --format github src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "hls.js": "^1.7.4",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "temporal-polyfill": "^0.3.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.3.1",
    "@storybook/addon-docs": "^9.1.21",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/addon-onboarding": "^9.1.21",
    "@storybook/react-vite": "^9.1.21",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/ui": "^4.1.12",
    "globals": "^17.14.0",
    "happy-dom": "^20.14.6",
    "material-symbols": "^0.48.3",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.92.0",
    "postcss-cli": "^11.0.1",
    "storybook": "^9.1.21",
    "typescript": "^6.0.3",
    "vite": "^6.4.5",
    "vite-plugin-dts": "^4.5.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
